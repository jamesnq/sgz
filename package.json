{
  "name": "sgz",
  "version": "1.0.0",
  "description": "Sub Game Zone",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "analyze": "cross-env ANALYZE=true NODE_OPTIONS=--no-deprecation next build --webpack",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "postinstall": "node scripts/patch-payload-auth.js",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "gen": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create --skip-empty && payload generate:types && payload generate:importmap && payload generate:db-schema",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "prepare": "husky",
    "quality": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "start": "cross-env NODE_OPTIONS=--no-deprecation payload migrate --force-accept-warning && next start",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^5.2.2",
    "@meilisearch/instant-meilisearch": "^0.30.0",
    "@novu/api": "^3.18.2",
    "@novu/react": "^3.18.2",
    "@payload-enchants/fields-select": "^1.2.2",
    "@payloadcms/db-postgres": "^3.87.0",
    "@payloadcms/email-resend": "^3.87.0",
    "@payloadcms/live-preview-react": "^3.87.0",
    "@payloadcms/next": "^3.87.0",
    "@payloadcms/payload-cloud": "^3.87.0",
    "@payloadcms/plugin-nested-docs": "^3.87.0",
    "@payloadcms/plugin-search": "^3.87.0",
    "@payloadcms/plugin-seo": "^3.87.0",
    "@payloadcms/richtext-lexical": "^3.87.0",
    "@payloadcms/storage-s3": "^3.87.0",
