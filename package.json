      "minimatch@>=3 <4": "3.1.5",
      "minimatch@>=5 <6": "5.1.9",
      "minimatch@>=9 <10": "9.0.9",
      "nodemailer@>=9 <10": "9.0.4",
      "path-to-regexp@>=8 <9": "8.4.2",
      "picomatch@>=2 <3": "2.3.2",
      "picomatch@>=4 <5": "4.0.5",
      "postcss@>=8 <9": "8.5.26",
      "preact@>=10 <11": "10.29.8",
      "protobufjs@>=7 <8": "7.6.5",
      "sharp@>=0.34 <0.36": "0.35.3",
      "tmp@>=0.2 <0.3": "0.2.7",
      "undici@>=7 <8": "7.29.0",
      "vite@>=7 <8": "7.3.6",
      "ws@>=8 <9": "8.21.2"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml}": "prettier --write"
  }
}
