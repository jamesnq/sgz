    "prism-react-renderer": "^2.4.1",
    "qs": "^6.15.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "7.72.1",
    "react-instantsearch": "^7.29.0",
    "react-instantsearch-nextjs": "^1.1.4",
    "react-intersection-observer": "^10.0.3",
    "react-toastify": "^11.0.5",
    "react-window": "2.3.0",
    "request-ip": "^3.3.0",
    "rimraf": "^6.1.3",
    "sharp": "0.34.1",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-essentials": "^10.1.1",
    "use-context-selector": "^2.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "16.3.0",
    "@playwright/test": "^1.59.1",
    "@sgz/eslint-config": "workspace:*",
    "@sgz/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/eslint-plugin-query": "^5.96.2",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/crypto-js": "^4.2.2",
    "@types/escape-html": "^1.0.4",
    "@types/lodash": "^4.17.24",
    "@types/marked": "^6.0.0",
    "@types/node": "24.12.2",
    "@types/qs": "^6.15.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/request-ip": "^0.0.41",
    "autoprefixer": "^10.4.27",
    "copyfiles": "^2.4.1",
    "eslint": "^9.26.0",
    "eslint-config-next": "16.2.11",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "tailwindcss": "4.2.2",
    "tsx": "^4.21.0",
    "turbo": "2.10.8",
    "typescript": "5.8.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "@eslint/eslintrc>ajv": "6.15.0",
      "@modelcontextprotocol/sdk@>=1 <2": "1.30.0",
      "axios@>=1 <2": "1.19.0",
      "brace-expansion@>=1 <2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "drizzle-orm@>=0.40 <0.46": "0.45.2",
